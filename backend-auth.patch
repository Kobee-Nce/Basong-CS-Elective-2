+import 'package:flutter/material.dart';
+
+import '../state/auth_controller.dart';
+import '../theme/app_theme.dart';
+
+/// Email + password sign in / sign up, plus "Continue with GitHub".
+/// The router leaves this screen on its own once a session exists.
+class LoginScreen extends StatefulWidget {
+  const LoginScreen({super.key});
+
+  @override
+  State<LoginScreen> createState() => _LoginScreenState();
+}
+
+class _LoginScreenState extends State<LoginScreen> {
+  final auth = AuthController.instance;
+
+  final _formKey = GlobalKey<FormState>();
+  final _email = TextEditingController();
+  final _password = TextEditingController();
+
+  bool _isSignUp = false;
+  bool _hidePassword = true;
+
+  @override
+  void dispose() {
+    _email.dispose();
+    _password.dispose();
+    super.dispose();
+  }
+
+  Future<void> _submitEmail() async {
+    if (!_formKey.currentState!.validate()) return;
+
+    final email = _email.text.trim();
+    final password = _password.text;
+
+    if (_isSignUp) {
+      await auth.signUpWithEmail(email, password);
+      // Account needs confirming → switch back to the sign-in form.
+      if (auth.info != null && mounted) {
+        setState(() => _isSignUp = false);
+      }
+    } else {
+      await auth.signInWithEmail(email, password);
+    }
+  }
+
+  void _toggleMode() {
+    auth.clearMessages();
+    setState(() => _isSignUp = !_isSignUp);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final isDark = Theme.of(context).brightness == Brightness.dark;
+
+    return Scaffold(
+      body: Container(
+        decoration: BoxDecoration(
+          gradient: isDark ? AppTheme.darkGradient : AppTheme.lightGradient,
+        ),
+        child: SafeArea(
+          child: Center(
+            child: SingleChildScrollView(
+              padding: const EdgeInsets.all(24),
+              child: ConstrainedBox(
+                constraints: const BoxConstraints(maxWidth: 420),
+                child: ListenableBuilder(
+                  listenable: auth,
+                  builder: (context, _) => _buildCard(),
+                ),
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+
+  Widget _buildCard() {
+    final busy = auth.isLoading;
+
+    return Column(
+      mainAxisSize: MainAxisSize.min,
+      children: [
+        const Icon(Icons.sports_esports_rounded, color: Colors.white, size: 64),
+
+        const SizedBox(height: 8),
+
+        const Text(
+          'Game Credits Shop',
+          textAlign: TextAlign.center,
+          style: TextStyle(
+            color: Colors.white,
+            fontSize: 32,
+            fontWeight: FontWeight.bold,
+          ),
+        ),
+
+        Text(
+          _isSignUp ? 'Create your account' : 'Sign in to continue',
+          style: const TextStyle(color: Colors.white70, fontSize: 18),
+        ),
+
+        const SizedBox(height: 24),
+
+        Card(
+          child: Padding(
+            padding: const EdgeInsets.all(20),
+            child: Form(
+              key: _formKey,
+              child: Column(
+                crossAxisAlignment: CrossAxisAlignment.stretch,
+                children: [
+                  TextFormField(
+                    controller: _email,
+                    enabled: !busy,
+                    keyboardType: TextInputType.emailAddress,
+                    autofillHints: const [AutofillHints.email],
+                    decoration: const InputDecoration(
+                      labelText: 'Email',
+                      prefixIcon: Icon(Icons.email_outlined),
+                      border: OutlineInputBorder(),
+                    ),
+                    validator: (value) {
+                      final v = value?.trim() ?? '';
+                      if (v.isEmpty) return 'Enter your email';
+                      if (!v.contains('@') || !v.contains('.')) {
+                        return 'Enter a valid email';
+                      }
+                      return null;
+                    },
+                  ),
+
+                  const SizedBox(height: 14),
+
+                  TextFormField(
+                    controller: _password,
+                    enabled: !busy,
+                    obscureText: _hidePassword,
+                    autofillHints: const [AutofillHints.password],
+                    onFieldSubmitted: (_) => _submitEmail(),
+                    decoration: InputDecoration(
+                      labelText: 'Password',
+                      prefixIcon: const Icon(Icons.lock_outline),
+                      border: const OutlineInputBorder(),
+                      suffixIcon: IconButton(
+                        onPressed: () =>
+                            setState(() => _hidePassword = !_hidePassword),
+                        icon: Icon(
+                          _hidePassword
+                              ? Icons.visibility_outlined
+                              : Icons.visibility_off_outlined,
+                        ),
+                      ),
+                    ),
+                    validator: (value) {
+                      if ((value ?? '').isEmpty) return 'Enter your password';
+                      // Supabase's default minimum password length.
+                      if (_isSignUp && value!.length < 6) {
+                        return 'Use at least 6 characters';
+                      }
+                      return null;
+                    },
+                  ),
+
+                  if (auth.error != null) ...[
+                    const SizedBox(height: 14),
+                    _Notice(
+                      text: auth.error!,
+                      color: AppTheme.valorantRed,
+                      icon: Icons.error_outline,
+                    ),
+                  ],
+
+                  if (auth.info != null) ...[
+                    const SizedBox(height: 14),
+                    _Notice(
+                      text: auth.info!,
+                      color: Colors.green.shade700,
+                      icon: Icons.mark_email_read_outlined,
+                    ),
+                  ],
+
+                  const SizedBox(height: 18),
+
+                  ElevatedButton(
+                    onPressed: busy ? null : _submitEmail,
+                    child: busy
+                        ? const SizedBox(
+                            width: 22,
+                            height: 22,
+                            child: CircularProgressIndicator(
+                              strokeWidth: 2.5,
+                              color: Colors.white,
+                            ),
+                          )
+                        : Text(
+                            _isSignUp ? 'Create account' : 'Sign in',
+                            style: const TextStyle(fontSize: 18),
+                          ),
+                  ),
+
+                  TextButton(
+                    onPressed: busy ? null : _toggleMode,
+                    child: Text(
+                      _isSignUp
+                          ? 'Already have an account? Sign in'
+                          : "Don't have an account? Sign up",
+                    ),
+                  ),
+
+                  const Padding(
+                    padding: EdgeInsets.symmetric(vertical: 8),
+                    child: Row(
+                      children: [
+                        Expanded(child: Divider()),
+                        Padding(
+                          padding: EdgeInsets.symmetric(horizontal: 12),
+                          child: Text('or'),
+                        ),
+                        Expanded(child: Divider()),
+                      ],
+                    ),
+                  ),
+
+                  // Third-party provider (activity requirement).
+                  OutlinedButton.icon(
+                    onPressed: busy ? null : auth.signInWithGitHub,
+                    style: OutlinedButton.styleFrom(
+                      padding: const EdgeInsets.symmetric(vertical: 14),
+                      backgroundColor: const Color(0xFF24292F),
+                      foregroundColor: Colors.white,
+                      side: BorderSide.none,
+                      shape: RoundedRectangleBorder(
+                        borderRadius: BorderRadius.circular(14),
+                      ),
+                    ),
+                    icon: const Icon(Icons.code_rounded),
+                    label: const Text(
+                      'Continue with GitHub',
+                      style: TextStyle(fontSize: 18),
+                    ),
+                  ),
+                ],
+              ),
+            ),
+          ),
+        ),
+      ],
+    );
+  }
+}
+
+class _Notice extends StatelessWidget {
+  final String text;
+  final Color color;
+  final IconData icon;
+
+  const _Notice({
+    required this.text,
+    required this.color,
+    required this.icon,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    return Container(
+      padding: const EdgeInsets.all(12),
+      decoration: BoxDecoration(
+        color: color.withOpacity(.12),
+        borderRadius: BorderRadius.circular(12),
+        border: Border.all(color: color.withOpacity(.5)),
+      ),
+      child: Row(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Icon(icon, color: color, size: 20),
+          const SizedBox(width: 8),
+          Expanded(
+            child: Text(text, style: TextStyle(color: color)),
+          ),
+        ],
+      ),
+    );
+  }
+}
diff --git a/lib/state/auth_controller.dart b/lib/state/auth_controller.dart
new file mode 100644
index 0000000..4b342df
--- /dev/null
+++ b/lib/state/auth_controller.dart
@@ -0,0 +1,138 @@
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+import 'package:supabase_flutter/supabase_flutter.dart';
+
+import '../config/supabase_config.dart';
+
+/// Signed-in user + sign-in/sign-up/sign-out actions, backed by Supabase Auth.
+///
+/// Same pattern as CartController / ProductsController. The router listens
+/// to this controller, so signing in or out moves the user between the
+/// login screen and the shop automatically.
+class AuthController extends ChangeNotifier {
+  static final AuthController instance = AuthController._();
+
+  AuthController._();
+
+  /// Where GitHub (through Supabase) sends the user back after signing in.
+  /// The same scheme is registered in macos/ios Info.plist and
+  /// AndroidManifest.xml, and must be added in Supabase under
+  /// Authentication → URL Configuration → Redirect URLs.
+  static const String oauthRedirect =
+      'io.supabase.gamecreditsshop://login-callback/';
+
+  StreamSubscription<AuthState>? _subscription;
+
+  bool isLoading = false;
+  String? error;
+
+  /// Shown after sign-up when Supabase still needs the email confirmed.
+  String? info;
+
+  GoTrueClient get _auth => Supabase.instance.client.auth;
+
+  User? get user =>
+      SupabaseConfig.isConfigured ? _auth.currentUser : null;
+
+  bool get isSignedIn => user != null;
+
+  /// Call once at startup (after Supabase.initialize).
+  void init() {
+    if (!SupabaseConfig.isConfigured || _subscription != null) return;
+
+    // Fires on sign in, sign out, token refresh, and when the app is
+    // reopened from the GitHub redirect link.
+    _subscription = _auth.onAuthStateChange.listen(
+      (state) {
+        if (state.event == AuthChangeEvent.signedIn) {
+          isLoading = false;
+          error = null;
+          info = null;
+        }
+        notifyListeners();
+      },
+      onError: (Object e) {
+        isLoading = false;
+        error = _describe(e);
+        notifyListeners();
+      },
+    );
+  }
+
+  Future<void> signInWithEmail(String email, String password) {
+    return _run(() async {
+      await _auth.signInWithPassword(email: email, password: password);
+    });
+  }
+
+  Future<void> signUpWithEmail(String email, String password) {
+    return _run(() async {
+      final response = await _auth.signUp(email: email, password: password);
+
+      // "Confirm email" is on by default in Supabase: the account exists
+      // but there's no session until the link in the email is clicked.
+      if (response.session == null) {
+        info = 'Account created! Check $email for a confirmation link, '
+            'then sign in.';
+      }
+    });
+  }
+
+  /// Opens GitHub in the browser. The result arrives later through
+  /// onAuthStateChange when the redirect link reopens the app.
+  Future<void> signInWithGitHub() {
+    return _run(() async {
+      await _auth.signInWithOAuth(
+        OAuthProvider.github,
+        // On web, Supabase returns to the page that started the sign-in.
+        redirectTo: kIsWeb ? null : oauthRedirect,
+        authScreenLaunchMode: kIsWeb
+            ? LaunchMode.platformDefault
+            : LaunchMode.externalApplication,
+      );
+    });
+  }
+
+  Future<void> signOut() => _run(_auth.signOut);
+
+  void clearMessages() {
+    error = null;
+    info = null;
+    notifyListeners();
+  }
+
+  Future<void> _run(Future<void> Function() action) async {
+    if (!SupabaseConfig.isConfigured) {
+      error = 'Supabase is not configured yet. Add your project URL and '
+          'anon key in lib/config/supabase_config.dart.';
+      notifyListeners();
+      return;
+    }
+
+    isLoading = true;
+    error = null;
+    info = null;
+    notifyListeners();
+
+    try {
+      await action();
+    } catch (e) {
+      error = _describe(e);
+    } finally {
+      isLoading = false;
+      notifyListeners();
+    }
+  }
+
+  String _describe(Object e) {
+    if (e is AuthException) return e.message;
+    return 'Something went wrong. Check your internet connection.\n($e)';
+  }
+
+  @override
+  void dispose() {
+    _subscription?.cancel();
+    super.dispose();
+  }
+}
